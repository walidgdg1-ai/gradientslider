        json.dumps(records, ensure_ascii=False, indent=2), encoding="utf-8"
    )

    failure_rows = []
    failure_by_id = {item["entry"]["id"]: item for item in final_failures}
    for entry in entries:
        if entry["id"] not in accepted:
            item = failure_by_id.get(entry["id"], {})
            failure_rows.append({
                "priority": entry["priority"],
                "id": entry["id"],
                "category": entry["category"],
                "work": entry["work"],
                "location": entry["location"],
                "reason": item.get("reason", "not accepted"),
            })
    with open(ROOT / "failures.csv", "w", encoding="utf-8-sig", newline="") as handle:
        writer = csv.DictWriter(
            handle,
            fieldnames=["priority", "id", "category", "work", "location", "reason"],
        )
        writer.writeheader()
        writer.writerows(failure_rows)

    category_counts = {}
    for record in records:
        category_counts[record["category"]] = category_counts.get(record["category"], 0) + 1
    summary_lines = [
        f"Curated environments requested: {len(entries)}",
        f"Images accepted: {len(records)}",
        f"Images failed: {len(entries) - len(records)}",
        f"Target: {TARGET}",
        f"Elapsed seconds: {round(elapsed(), 1)}",
        "",
        "Accepted by category:",
    ]
    for category in sorted(category_counts):
        summary_lines.append(f"- {category}: {category_counts[category]}")
    summary_lines.extend([
        "",
        "Validation: exact work/location metadata, landscape geometry, face-area rejection,",
        "resolution, sharpness, OCR/text-overlay checks, SHA-256 and perceptual deduplication.",
    ])
    (ROOT / "README.txt").write_text("\n".join(summary_lines) + "\n", encoding="utf-8")
    make_contact_sheets(records)
    return records


def package_output():
    if ZIP_PATH.exists():
        ZIP_PATH.unlink()
    if not ROOT.exists():
        return
    with zipfile.ZipFile(ZIP_PATH, "w", zipfile.ZIP_DEFLATED, allowZip64=True) as archive:
        for path in sorted(ROOT.rglob("*")):
            if path.is_file():
                archive.write(path, path.relative_to(ROOT.parent))


def load_entries():
    entries = []
    for catalog_file in sorted(CATALOG_DIR.glob("*.tsv")):
        with catalog_file.open("r", encoding="utf-8") as handle:
            for line_number, raw in enumerate(handle, 1):
                raw = raw.rstrip("\n")
                if not raw.strip():
                    continue
                parts = raw.split("\t")
                if len(parts) != 5:
                    raise RuntimeError(f"{catalog_file}:{line_number}: expected 5 TSV fields, got {len(parts)}")
                priority_text, category, work, location, hint = parts
                priority = int(priority_text)
                entries.append({
                    "priority": priority,
                    "category": category,
                    "work": work,
                    "location": location,
                    "hint": hint,
                    "id": f"{priority:03d}-{slug(work)}-{slug(location)}",
                })
    entries.sort(key=lambda row: row["priority"])
    return entries


# Strict visual-authenticity layer. It is declared after the base functions so the
# original downloader remains available while selection becomes much more severe.
import pytesseract

BAD_DOMAINS = BAD_DOMAINS + (
    "youtube.com", "youtu.be", "ytimg.com", "sketchfab.com", "moddb.com",
    "nexusmods.com", "sidequestvr.com", "moonvrhome.com", "wallhaven.cc",
    "wallpaper", "inspiredpencil.com", "fity.club", "spriters-resource.com",
    "powertrials.org", "weebly.com", "fineartamerica.com", "deviantart.com",
)
HARD_NEGATIVE_META = HARD_NEGATIVE_META + (
    "3d model", "download free 3d", "fan remake", "fan-made remake",
    "unreal engine remake", "mod showcase", "custom home", "sprite sheet",
    "sprites resource", "texture pack", "comparison", "evolution",
    "then and now", "ps5 pro", "4k hdr", "wallpaper", "thumbnail",
    "concept art", "map layout", "map overview", "reaction video",
)
SOFT_NEGATIVE_META = SOFT_NEGATIVE_META + (
    "remake", "remastered", "mod", "4k", "8k", "hd edition",
    "walkthrough", "guide", "review", "ambience", "asmr", "teaser",
)

_NEGATIVE_SUFFIX = (
    " -remake -remastered -mod -wallpaper -thumbnail -youtube "
    "-comparison -concept -sprite -map-layout"
)
CATEGORY_QUERIES["video_game"] = [
    'site:mobygames.com "{work}" "{location}" screenshot',
    'site:ign.com "{work}" "{location}" screenshot',
    'site:fandom.com "{work}" "{location}" screenshot',
    '"{work}" "{location}" original game screenshot no HUD' + _NEGATIVE_SUFFIX,
] + CATEGORY_QUERIES["video_game"]
CATEGORY_QUERIES["film"] = [
    'site:movie-screencaps.com "{work}" "{location}"',
    'site:fancaps.net "{work}" "{location}"',
    'site:cap-that.com "{work}" "{location}"',
    '"{work}" "{location}" authentic film still' + _NEGATIVE_SUFFIX,
] + CATEGORY_QUERIES["film"]
CATEGORY_QUERIES["tv_series"] = [
    'site:fancaps.net "{work}" "{location}"',
    'site:cap-that.com "{work}" "{location}"',
    '"{work}" "{location}" authentic episode still' + _NEGATIVE_SUFFIX,
] + CATEGORY_QUERIES["tv_series"]
CATEGORY_QUERIES["western_animation"] = [
    'site:fancaps.net "{work}" "{location}" screencap',
    '"{work}" "{location}" original episode screencap' + _NEGATIVE_SUFFIX,
] + CATEGORY_QUERIES["western_animation"]
CATEGORY_QUERIES["anime"] = [
    'site:fancaps.net "{work}" "{location}" anime screencap',
    '"{work}" "{location}" original anime episode screencap' + _NEGATIVE_SUFFIX,
] + CATEGORY_QUERIES["anime"]
CATEGORY_QUERIES["music_video"] = [
    'site:imvdb.com "{work}" "{location}"',
    '"{work}" "{location}" official music video still -youtube -thumbnail',
] + CATEGORY_QUERIES["music_video"]
CATEGORY_QUERIES["tv_youtube_set"] = [
    '"{work}" "{location}" official studio photograph -thumbnail -reaction',
    '"{work}" empty studio set wide shot',
] + CATEGORY_QUERIES["tv_youtube_set"]
CATEGORY_QUERIES["real_world"] = [
    'site:commons.wikimedia.org "{work}" "{location}"',
    'site:wikipedia.org "{work}" "{location}" photograph',
] + CATEGORY_QUERIES["real_world"]

_base_metadata_score = metadata_score


def metadata_score(candidate: dict, entry: dict) -> float:
    score = _base_metadata_score(candidate, entry)
    if score <= -900:
        return score
    blob = metadata_blob(candidate)
    host = domain(candidate.get("page", "") or candidate.get("image", ""))
    trusted = (
        "mobygames.com", "ign.com", "gamespot.com", "fandom.com", "wikia.com",
        "halopedia.org", "theportalwiki.com", "minecraft.wiki", "nintendo.com",
        "playstation.com", "xbox.com", "rockstargames.com", "movie-screencaps.com",
        "fancaps.net", "cap-that.com", "screencapped.net", "wikimedia.org",
        "wikipedia.org", "nasa.gov", "un.org", "parliament.uk", "imvdb.com",
    )
    article_heavy = (
        "gamerant.com", "screenrant.com", "earlygame.com", "hardcoregamer.com",
        "gamingbolt.com", "pcgamesn.com", "playground.ru", "forumcommunity.net",
    )
    if any(token in host for token in trusted):
        score += 6.0
    if any(token in host for token in article_heavy):
        score -= 3.0
    if any(token in blob for token in ("screenshot", "screencap", "film still", "episode still")):
        score += 2.5
    if "official" in blob:
        score += 1.0
    if any(token in blob for token in ("remake", "remastered", "mod", "ambience", "asmr")):
        score -= 4.0
    return score


def search_candidates(query: str, entry: dict):
    rows = ddg_images(query)
    rows.extend(bing_images(query))
    if entry["category"] == "real_world":
        rows.extend(commons_images(f'{entry["work"]} {entry["location"]}'))
    output = []
    local_seen = set()
    for candidate in rows:
        image_url = candidate.get("image", "")
        clean_key = image_url.split("?")[0]
        if not image_url.startswith("http") or clean_key in local_seen:
            continue
        if is_bad_domain(image_url) or is_bad_domain(candidate.get("page", "")):
            continue
        local_seen.add(clean_key)
        score = metadata_score(candidate, entry)
        if score <= -900:
            continue
        output.append((score, candidate))
    output.sort(key=lambda pair: -pair[0])
    return output


_base_fetch_and_validate = fetch_and_validate


def fetch_and_validate(candidate: dict, entry: dict, meta_score: float, relaxed: bool, slot: int):
    result = _base_fetch_and_validate(candidate, entry, meta_score, relaxed, slot)
    if result is None:
        return None
    path = Path(result["temp_path"])
    try:
        image = Image.open(path).convert("RGB")
        preview = image.copy()
        preview.thumbnail((1280, 1280), Image.Resampling.LANCZOS)
        word_count = 0
        text_area = 0
        if shutil.which("tesseract"):
            data = pytesseract.image_to_data(
                preview,
                config="--psm 11",
                output_type=pytesseract.Output.DICT,
            )
            for index, text in enumerate(data.get("text", [])):
                clean = norm(text)
                try:
                    confidence = float(data["conf"][index])
                except Exception:
                    confidence = -1
                if confidence >= 48 and len(clean) >= 2:
                    word_count += 1
                    text_area += max(0, int(data["width"][index])) * max(0, int(data["height"][index]))
        text_area_ratio = text_area / max(1, preview.width * preview.height)
        strict_categories = {
            "video_game", "film", "tv_series", "western_animation", "anime", "music_video"
        }
        if entry["category"] in strict_categories:
            reject = word_count >= 6 or text_area_ratio >= 0.050
        elif entry["category"] == "tv_youtube_set":
            reject = word_count >= 15 or text_area_ratio >= 0.12
        else:
            reject = word_count >= 22 or text_area_ratio >= 0.16
        if reject:
            path.unlink(missing_ok=True)
            return None
        result["ocr_word_count"] = word_count
        result["ocr_text_area_ratio"] = round(text_area_ratio, 5)
        return result
    except Exception:
        return result


def main():
    all_entries = load_entries()
    if len(all_entries) != 300:
        raise RuntimeError(f"Expected exactly 300 curated entries, got {len(all_entries)}")
    priorities = [entry["priority"] for entry in all_entries]
    if priorities != list(range(1, 301)):
        raise RuntimeError("Priorities must be a continuous 1..300 sequence")
    if len({entry["id"] for entry in all_entries}) != 300:
        raise RuntimeError("Every environment must have a unique generated ID")

    priority_start = int(os.getenv("PRIORITY_START", "1"))
    priority_end = int(os.getenv("PRIORITY_END", "300"))
    if not (1 <= priority_start <= priority_end <= 300):
        raise RuntimeError(f"Invalid batch range {priority_start}..{priority_end}")
    entries = [
        entry for entry in all_entries
        if priority_start <= entry["priority"] <= priority_end
    ]
    expected_count = priority_end - priority_start + 1
    if len(entries) != expected_count:
        raise RuntimeError(
            f"Expected {expected_count} entries for batch {priority_start}..{priority_end}, got {len(entries)}"
        )

    shutil.rmtree(ROOT, ignore_errors=True)
    shutil.rmtree(CANDIDATE_ROOT, ignore_errors=True)
    ROOT.mkdir(parents=True)
    CANDIDATE_ROOT.mkdir(parents=True)
    accepted = {}
    accepted_hashes = []
    accepted_shas = set()
    final_failures = []

    try:
        print(
            f"Starting strict harvest for priorities {priority_start}..{priority_end} "
            f"({len(entries)} iconic environments)",
            flush=True,
        )
        strict_results = run_parallel(entries, relaxed=False)
        strict_failures = select_results(
            entries, strict_results, "strict", accepted, accepted_hashes, accepted_shas
        )
        print(f"Strict selection accepted {len(accepted)}/{len(entries)}", flush=True)

        retry_entries = [item["entry"] for item in strict_failures]
        if retry_entries and not global_budget_exhausted():
            print(f"Starting relaxed recovery for {len(retry_entries)} entries", flush=True)
            relaxed_results = run_parallel(retry_entries, relaxed=True)
            final_failures = select_results(
                retry_entries, relaxed_results, "relaxed", accepted, accepted_hashes, accepted_shas
            )
        else:
            final_failures = strict_failures
    finally:
        records = write_reports(entries, accepted, final_failures)
        package_output()
        shutil.rmtree(CANDIDATE_ROOT, ignore_errors=True)
        print((ROOT / "README.txt").read_text(encoding="utf-8"), flush=True)

    if len(records) < TARGET:
        raise SystemExit(2)


if __name__ == "__main__":
    main()
