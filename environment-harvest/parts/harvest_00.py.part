def norm(value: str) -> str:
    value = unicodedata.normalize("NFKD", value or "").encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9]+", " ", value.lower()).strip()


def slug(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", norm(value)).strip("-")[:110]


def domain(url: str) -> str:
    try:
        return urlparse(url or "").netloc.lower()
    except Exception:
        return ""


def is_bad_domain(url: str) -> bool:
    host = domain(url)
    return any(bad in host for bad in BAD_DOMAINS)


def is_good_domain(url: str) -> bool:
    haystack = (url or "").lower()
    return any(good in haystack for good in GOOD_DOMAINS)


def elapsed() -> float:
    return time.monotonic() - START


def global_budget_exhausted() -> bool:
    return elapsed() >= RUN_BUDGET_SECONDS


